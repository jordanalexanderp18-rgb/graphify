{
  "name": "agenda-barberia",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agenda, reservas online, caja y comisiones para barberías.",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server/index.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "e2e": "node --disable-warning=ExperimentalWarning e2e/run.mjs",
    "tokens": "node scripts/tokens.mjs"
  }
}
