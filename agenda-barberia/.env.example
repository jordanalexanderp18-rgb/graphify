# Copia a .env y completa solo lo que uses. Nada es obligatorio para probar.
PORT=3000
DB_FILE=data/app.db
# URL pública (para los enlaces en los mensajes), p. ej. https://tudominio.com
PUBLIC_URL=
# 1 si corre detrás de un proxy HTTPS (Fly, Render, Nginx)
TRUST_PROXY=
# WhatsApp Business Platform (Cloud API) de Meta. Sin esto, los mensajes quedan
# en Mensajes para enviarlos con un toque desde el WhatsApp del local.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
# Email con Resend
RESEND_API_KEY=
EMAIL_FROM=
# SMS con Twilio (si el negocio elige SMS como canal)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Suscripciones con Stripe (Checkout + Portal). Crea 2 productos con precio mensual y anual.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BARBERIA_MONTH=
STRIPE_PRICE_BARBERIA_YEAR=
STRIPE_PRICE_CADENA_MONTH=
STRIPE_PRICE_CADENA_YEAR=
